        "totalClassesCount": { "type": "number" },
        "passRatePercent": { "type": "number" },
        "academicCalendarNote": { "type": "string", "maxLength": 2000 },
        "holidayListNote": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolNameBn", "updatedAt"]
    },
    "HeroSlide": {
      "title": "Homepage Hero Slide",
      "description": "Image slider entry displayed on the public homepage.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "subtitle": { "type": "string", "maxLength": 280 },
        "imageUrl": { "type": "string", "minLength": 4, "maxLength": 500 },
        "orderIndex": { "type": "number" },
        "isActive": { "type": "boolean" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "orderIndex", "isActive", "authorUid", "createdAt", "updatedAt"]
    },
    "GoverningMember": {
      "title": "Governing Body Member",
      "description": "School director / managing committee profile and statement.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "designation": { "type": "string", "minLength": 2, "maxLength": 100 },
        "qualification": { "type": "string", "maxLength": 140 },
        "responsibility": { "type": "string", "maxLength": 180 },
        "bio": { "type": "string", "maxLength": 1000 },
        "speech": { "type": "string", "maxLength": 1500 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "joinedDate": { "type": "string", "maxLength": 40 },
        "termEndDate": { "type": "string", "maxLength": 40 },
