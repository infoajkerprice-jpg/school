      "properties": {
        "schoolNameBn": { "type": "string", "minLength": 2, "maxLength": 180 },
        "schoolNameEn": { "type": "string", "maxLength": 180 },
        "schoolSubtitleBn": { "type": "string", "maxLength": 180 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "eiin": { "type": "string", "maxLength": 30 },
        "schoolCode": { "type": "string", "maxLength": 30 },
        "regNo": { "type": "string", "maxLength": 40 },
        "establishedYear": { "type": "string", "maxLength": 20 },
        "aboutTitle": { "type": "string", "maxLength": 140 },
        "aboutText": { "type": "string", "maxLength": 4000 },
        "historyText": { "type": "string", "maxLength": 4000 },
        "missionText": { "type": "string", "maxLength": 4000 },
        "aboutImageUrl": { "type": "string", "maxLength": 500 },
        "principalName": { "type": "string", "maxLength": 120 },
        "principalDesignation": { "type": "string", "maxLength": 120 },
