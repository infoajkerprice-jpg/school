        "subject": { "type": "string", "minLength": 2, "maxLength": 80 },
        "shift": { "type": "string", "enum": ["Morning", "Day", "Both"] },
        "status": { "type": "string", "enum": ["Active", "OnLeave", "Inactive"] },
