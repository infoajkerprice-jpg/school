      },
      "required": ["date", "className", "section", "studentId", "studentName", "rollNumber", "status", "markedByUid", "createdAt", "updatedAt"]
    },
    "ExamResult": {
      "title": "Examination Result",
      "description": "Student term examination marksheet calculated on Bangladesh NCTB GPA 5.00 scale.",
      "type": "object",
