        "joiningDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Active", "OnLeave", "Inactive"] },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "facultyId", "name", "designation", "department", "phone", "email", "salaryBdt", "status", "createdAt", "updatedAt"]
    },
