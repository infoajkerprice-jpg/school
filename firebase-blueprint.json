        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "designation", "orderIndex", "authorUid", "createdAt", "updatedAt"]
    },
    "ImportantLink": {
      "title": "Important Institutional Link",
      "description": "External government education portal or key resource link.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "url": { "type": "string", "minLength": 4, "maxLength": 500 },
        "category": { "type": "string", "maxLength": 60 },
        "orderIndex": { "type": "number" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "url", "orderIndex", "authorUid", "createdAt", "updatedAt"]
    },
    "StudentAchievement": {
      "title": "Meritorious Student & Achievement",
      "description": "Public showcase profile of meritorious students and awards.",
      "type": "object",
      "properties": {
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "className": { "type": "string", "minLength": 1, "maxLength": 40 },
        "rollNumber": { "type": "string", "minLength": 1, "maxLength": 20 },
        "academicYear": { "type": "string", "maxLength": 20 },
        "achievementTitle": { "type": "string", "minLength": 2, "maxLength": 180 },
        "description": { "type": "string", "maxLength": 800 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "className", "rollNumber", "achievementTitle", "authorUid", "createdAt", "updatedAt"]
    },
    "UserAccount": {
      "title": "User Account",
      "description": "Authenticated portal account storing user role and linked student/teacher/parent reference.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "teacher", "student", "parent"] },
        "linkedEntityId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminRegistry": {
      "title": "Admin Registry",
      "description": "Trusted administrator lookup document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "Student": {
      "title": "Student Record",
      "description": "Enrolled student record with academic placement and guardian contact information.",
      "type": "object",
      "properties": {
        "studentIdCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "rollNumber": { "type": "string", "minLength": 1, "maxLength": 20 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "nameBn": { "type": "string", "maxLength": 120 },
        "fatherName": { "type": "string", "maxLength": 120 },
        "motherName": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "className": { "type": "string", "minLength": 1, "maxLength": 40 },
        "section": { "type": "string", "minLength": 1, "maxLength": 20 },
        "shift": { "type": "string", "enum": ["Morning", "Day"] },
        "group": { "type": "string", "enum": ["General", "Science", "Business Studies", "Humanities"] },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "guardianName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "guardianPhone": { "type": "string", "minLength": 6, "maxLength": 25 },
        "address": { "type": "string", "maxLength": 300 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Graduated"] },
        "studentUid": { "type": "string", "maxLength": 128 },
        "parentUid": { "type": "string", "maxLength": 128 },
        "admissionYear": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentIdCode", "rollNumber", "name", "className", "section", "shift", "group", "gender", "guardianName", "guardianPhone", "status", "createdAt", "updatedAt"]
    },
    "FacultyPublic": {
      "title": "Public Faculty Profile",
      "description": "Publicly visible teacher directory entry without private contact or salary PII.",
