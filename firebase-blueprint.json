        "principalMessage": { "type": "string", "maxLength": 2500 },
        "tickerOverride": { "type": "string", "maxLength": 400 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 160 },
        "websiteUrl": { "type": "string", "maxLength": 300 },
        "facebookUrl": { "type": "string", "maxLength": 300 },
        "facebookVerified": { "type": "boolean" },
        "googleMapQuery": { "type": "string", "maxLength": 300 },
        "officeHours": { "type": "string", "maxLength": 140 },
        "educationMediums": { "type": "array", "description": "Bounded list of up to 10 education medium labels" },
        "classList": { "type": "array", "description": "Bounded list of up to 20 offered classes" },
        "highestClass": { "type": "string", "maxLength": 80 },
        "shifts": { "type": "array", "description": "Bounded list of up to 6 active shifts" },
        "specialPrograms": { "type": "array", "description": "Bounded list of up to 15 Islamic and special educational programs" },
